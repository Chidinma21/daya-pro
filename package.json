{
  "name": "daya-pro",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Daya Pro API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/client.test.cjs && node test/markets.test.cjs && node test/account.test.cjs && node test/orders.test.cjs && node test/trades.test.cjs && node test/deposits.test.cjs && node test/withdrawals.test.cjs && node test/webhooks.test.cjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "daya",
    "daya-pro",
    "trading",
    "sdk"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.4.5"
  }
}